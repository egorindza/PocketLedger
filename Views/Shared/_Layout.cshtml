@{
    var path = Context.Request.Path.Value ?? "/";
    var subscriptions = path.StartsWith("/subscriptions");
    var history = path.StartsWith("/history") || path.Contains("/expenses/") && path.EndsWith("/edit");
}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · PocketLedger</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip" href="#content">К содержимому</a>
<div class="shell">
    <aside class="rail">
        <a class="logo" href="/"><span aria-hidden="true">◕</span>PocketLedger</a>
        <nav aria-label="Основная навигация">
            <a href="/" aria-current="@((path is "/" or "/demo") ? "page" : null)"><i aria-hidden="true">◫</i><span>Обзор</span></a>
            <a href="/subscriptions" aria-current="@(subscriptions ? "page" : null)"><i aria-hidden="true">↻</i><span>Подписки</span></a>
            <a href="/history" aria-current="@(history ? "page" : null)"><i aria-hidden="true">≡</i><span>История</span></a>
        </nav>
        <span class="rail-note"><i aria-hidden="true"></i> Данные на этом устройстве</span>
    </aside>
    <main class="content" id="content">
        @if (TempData["Notice"] is string notice) { <p class="message" role="status">@notice</p> }
        @if (TempData["Error"] is string error) { <p class="message error" role="alert">@error</p> }
        @RenderBody()
    </main>
</div>
</body>
</html>
