@model Dashboard
@{
    ViewData["Title"] = "Обзор";
    var overviewPath = Model.Sample ? "/demo" : "/";
    var active = Model.Subscriptions.Count(x => !x.Paused);
    var categories = Model.Categories;
    var max = categories.Select(x => x.Minor).DefaultIfEmpty(1).Max();
    var currencies = Model.Monthly.Select(x => x.Currency).ToArray();
}
@if (Model.Sample)
{
    <div class="sample"><span><strong>Демонстрационные данные</strong> · цифры для примера</span><a href="/" class="text-link">К моим данным</a></div>
}
<header class="page-head">
    <div><p class="overline">@Model.Today.ToString("MMMM yyyy", Display.Russian)</p><h1>Обзор расходов</h1><p>Фактические траты, регулярные платежи и ближайшие списания.</p></div>
    <div class="actions"><a class="button secondary" href="/subscriptions/new">＋ Подписка</a><a class="button primary" href="/expenses/new">＋ Расход</a></div>
</header>
<section class="summary" aria-label="Сводка расходов">
    <article class="metric featured">
        <div><span class="metric-icon" aria-hidden="true">◓</span><h2>Потрачено в этом месяце</h2></div>
        @if (Model.Monthly.Count == 0) { <strong>0 ₽</strong> }
        else { <strong>@Display.Money(Model.Monthly[0].Minor, Model.Monthly[0].Currency)</strong> }
        <div class="metric-foot">
            @foreach (var total in Model.Monthly.Skip(1)) { <span>@Display.Money(total.Minor, total.Currency)</span> }
            @if (Model.Monthly.Count <= 1) { <span>@Model.MonthExpenses.Count записей в журнале</span> }
        </div>
    </article>
    <article class="metric">
        <div><span class="metric-icon pale" aria-hidden="true">◷</span><h2>Следующие платежи</h2></div>
        @if (Model.Scheduled.Count == 0) { <strong>0 ₽</strong> }
        else { <strong>@Display.Money(Model.Scheduled[0].Minor, Model.Scheduled[0].Currency)</strong> }
        <div class="metric-foot">
            @foreach (var total in Model.Scheduled.Skip(1)) { <span>@Display.Money(total.Minor, total.Currency)</span> }
            <span>На 30 дней с учётом просрочки</span>
        </div>
    </article>
    <article class="metric">
        <div><span class="metric-icon green" aria-hidden="true">↻</span><h2>Активные подписки</h2></div>
        <strong>@active</strong><div class="metric-foot"><span>@(Model.Subscriptions.Count - active) на паузе</span></div>
    </article>
</section>
@if (!Model.Sample && Model.Subscriptions.Count == 0 && Model.Expenses.Count == 0)
{
    <aside class="welcome"><div><h2>Начните с одной траты</h2><p>Добавьте подписку, чтобы увидеть дату следующего платежа, или сразу внесите разовый расход.</p></div><a href="/demo" class="button secondary">Посмотреть пример</a></aside>
}
<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-head"><div><h2>Ближайшие списания</h2><p>Личный календарь на 30 дней</p></div>@if (!Model.Sample) { <a class="text-link" href="/subscriptions">Все подписки</a> }</div>
        @if (Model.Due.Count == 0) { <div class="empty"><h3>Платежей пока нет</h3><p>Ближайшие списания появятся здесь после добавления подписки.</p></div> }
        @foreach (var item in Model.Due.Take(6))
        {
            <article class="row">
                <span class="tile" aria-hidden="true">@Display.Initial(item.Name)</span>
                <span class="row-text">
                @if (Model.Sample) { <strong>@item.Name</strong> } else { <a href="/subscriptions/@item.Id"><strong>@item.Name</strong></a> }
                <small class="@(item.Due < Model.Today ? "overdue" : "")">@(item.Due < Model.Today ? "Просрочен · " : "")@Display.Date(item.Due) · @item.Category</small></span>
                <strong class="amount">@Display.Money(item.Minor, item.Currency)</strong>
                @if (!Model.Sample) { <a class="button small secondary" href="/subscriptions/@item.Id/pay" aria-label="Записать платёж за @item.Name">Записать</a> }
            </article>
        }
    </section>
    <section class="panel">
        <div class="panel-head"><div><h2>На что ушли деньги</h2><p>Категории за текущий месяц</p></div>
            @if (currencies.Length > 1)
            {
                <nav class="segments" aria-label="Валюта графика">
                    @foreach (var currency in currencies) { <a class="@(currency == Model.ChartCurrency ? "selected" : "")" href="@($"{overviewPath}?currency={currency}")">@currency</a> }
                </nav>
            }
        </div>
        @if (categories.Count == 0) { <div class="empty"><h3>График пока пуст</h3><p>Здесь появятся категории записанных расходов.</p></div> }
        else
        {
            <div class="bars">
                @foreach (var category in categories)
                {
                    <div><div class="bar-label"><span>@category.Name</span><strong>@Display.Money(category.Minor, Model.ChartCurrency)</strong></div><meter min="0" max="@max" value="@category.Minor" aria-label="@category.Name">@category.Minor</meter></div>
                }
            </div>
        }
    </section>
</div>
<section class="panel recent">
    <div class="panel-head"><div><h2>Недавние расходы</h2><p>Записанные платежи и покупки за этот месяц</p></div>@if (!Model.Sample) { <a class="text-link" href="/history">Вся история</a> }</div>
    @if (Model.MonthExpenses.Count == 0) { <div class="empty"><h3>Записей за месяц пока нет</h3><a class="text-link" href="/expenses/new">Добавить расход</a></div> }
    @foreach (var row in Model.MonthExpenses.OrderByDescending(x => x.PaidOn).Take(5))
    {
        <article class="row">
            <span class="tile" aria-hidden="true">@Display.Initial(row.Name)</span>
            <span class="row-text">@if (Model.Sample) { <strong>@row.Name</strong> } else { <a href="/expenses/@row.Id/edit"><strong>@row.Name</strong></a> }<small>@Display.Date(row.PaidOn) · @row.Category</small></span>
            <strong class="amount">@Display.Money(row.Minor, row.Currency)</strong>
        </article>
    }
</section>
